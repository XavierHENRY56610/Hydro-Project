# Secrets — fichiers de configuration contenant des jetons (jamais versionnés)
lib/secret_config.py
lib/secret_config.example.py
**/secret_config*.py
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Données locales / sorties
*.log
/logs/

# Dossiers de données — entièrement ignorés (sauf centrales/REFERENCE/bv_rules.json
# et centrales/REFERENCE/centrales_calibration.json, versionnés)
/centrales/*
!/centrales/*.dvc
!/centrales/REFERENCE/
/centrales/REFERENCE/files/
/centrales/REFERENCE/config-general.json
/data/
/ARCHIVE/

# Dossier claude (specs/plans internes) — sauf la doc MLOps versionnée
/docs/
!/docs/mlops/
!/docs/mlops/**

# Artefacts modèle — squelette versionné, contenu ignoré
/weights/*
!/weights/.gitkeep
/outputs/*
!/outputs/.gitkeep

# Fichiers SIG (gros binaires, non liés au projet)
*.cpg
*.dbf
*.prj
*.shp
*.shx
*.tif
*.qgz
# Scripts de validation jetables (phase par phase)
_validate_*.py
