# Copier en .env (gitignoré). Toutes les valeurs sont optionnelles.

# --- Chemins externes (vides => dégradation gracieuse) -------------------
# Météo NWP / MNT / puissance : figés dans cette version, laisser vide.
PREVI_MNT=
PREVI_NAS_METEO=
PREVI_PUISSANCE_SOURCE_ROOT=

# --- DagsHub : git + remote DVC ----------------------------------------
# Token perso : dagshub.com -> Settings -> Tokens. Utilisé par DVC dans
# le conteneur (dvc pull / dvc push).
DAGSHUB_USER=
DAGSHUB_TOKEN=

# --- Identité git pour les commits de promotion (promotion.py) ----------
GIT_AUTHOR_NAME=previ-r2d2
GIT_AUTHOR_EMAIL=previ-r2d2@localhost

# --- MLflow (phase 01) ---
# Vide => suivi désactivé (no-op, comme en CI / tests). Avec la stack
# docker-compose, le service `trainer` pointe déjà sur http://mlflow:5000 par
# défaut — ne renseigner ici que pour cibler un serveur MLflow externe.
MLFLOW_TRACKING_URI=

# MinIO (artefacts MLflow). Défauts OK en local.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
